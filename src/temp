cd ~/mykernal

nasm -f elf32 boot.asm -o boot.o

gcc -m32 -ffreestanding -fno-pie -fno-stack-protector -c src/kernel.c -o kernel.o
gcc -m32 -ffreestanding -fno-pie -fno-stack-protector -c src/keyboard.c -o keyboard.o
gcc -m32 -ffreestanding -fno-pie -fno-stack-protector -c src/video.c -o video.o
gcc -m32 -ffreestanding -fno-pie -fno-stack-protector -c src/commands.c -o commands.o

ld -m elf_i386 -T linker.ld -o kernel.bin boot.o kernel.o keyboard.o video.o commands.o

grub-mkrescue -o kernel.iso iso/